.venv/
venv/
env/

# Caches Python et tests
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
tests/

# Gestion de versions
.git/
.github/
.gitignore

# Données générées et sorties
data/outputs/
data/raw/
data/chromadb/

# Fichiers système et IDE
.vscode/
.idea/
.editorconfig
*.swp
*.swo

# Builds et packages locaux
build/
dist/
*.egg-info/
iot-project-factory-pulse.zip

# Fichiers de présentation et tests racine (les dossiers docs/ et materials/ sont conservés pour le RAG)
PRESENTATION_*.md
test_*.py
